# ##########################################################
# requires

$:.unshift File.join(File.dirname(__FILE__), '..', 'lib')

require 'usb_cracker/cli'
require 'usb_cracker/prefix'
require 'usb_cracker/search'


# ##########################################################
# command-line handling

trap 'INT' do

  $stderr.puts ''
  $stderr.puts 'usb-cracker: processing cancelled ...'
  exit 130
end

options = UsbCracker::Cli.parse ARGV
UsbCracker::Cli.confirm_key_name! options

UsbCracker::Prefix.read! do |prefix|

  outcome = UsbCracker::Search.run(options, prefix)

  UsbCracker::Search.report(outcome)
end


# ############################## end of file ############################# #
